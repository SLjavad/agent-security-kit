{
  "env": {
    "SECURITY_HOOKS_MODE": "warn"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__KIT_DIR__/hooks/security-kit/guard-bash.cjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__KIT_DIR__/hooks/security-kit/scan-write.cjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__KIT_DIR__/hooks/security-kit/post-edit-scan.cjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
